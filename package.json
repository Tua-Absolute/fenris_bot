{
  "name": "fenris-bot",
  "version": "1.0.0",
  "description": "All-in-one Discord management bot: announcements, events, polls, and Claude-powered chat.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "invite": "tsx src/invite.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
