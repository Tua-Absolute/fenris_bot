# From the Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# From the Developer Portal > your app > General Information > Application ID
DISCORD_CLIENT_ID=
# Your server's ID (Discord: Settings > Advanced > Developer Mode, then right-click the server > Copy Server ID)
DISCORD_GUILD_ID=
# Time zone for times you type into commands (optional, defaults to America/Chicago)
TIMEZONE=America/Chicago

# --- Claude chat (optional). Leave blank to keep chat off. ---
# From console.anthropic.com > API Keys. Also turn on "Message Content Intent" in the Developer Portal (Bot page).
ANTHROPIC_API_KEY=
# Which Claude model answers. claude-opus-5-5 is the smartest; claude-haiku-5-5 is far cheaper.
CLAUDE_MODEL=claude-opus-5-5
# Max Claude replies per day across the whole server (keeps costs predictable)
CHAT_DAILY_LIMIT=200
